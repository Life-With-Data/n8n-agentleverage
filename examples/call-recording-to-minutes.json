						"index": 0
					}
				]
			]
		},
		"Wait for Transcript": {
			"main": [
				[
					{
						"node": "Minutes",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Minutes": {
			"main": [
				[
					{
						"node": "Wait for Minutes",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Wait for Minutes": {
			"main": [
				[
